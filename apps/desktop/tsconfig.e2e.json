{
  // A fourth pass, not e2e/** folded into tsconfig.test.json: that config uses
  // "moduleResolution": "bundler", but .mts files import .mjs-suffixed
  // specifiers (this workspace is CJS and todo-vault is ESM-only — see
  // e2e/harness.mts), which wants NodeNext instead. And *.ts globs do not match
  // .mts regardless.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["e2e/**/*.mts"]
}
