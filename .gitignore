node_modules/
dist/

# Personal Claude Code settings. .claude/settings.json is the shared one.
.claude/settings.local.json

# Claude Code's worktrees, which are checkouts of this repo living inside it.
# Tracking them would commit a copy of the tree into itself; they are also
# transient, and `git worktree remove` is what disposes of them, not a delete.
.claude/worktrees/

# MCP server config with machine-specific absolute paths (dist/ output, vault dir).
.mcp.json

# The example vault is its own git repository, so that --git auto-commit has
# somewhere to commit to. Keeping it out of this one avoids a nested repo.
/vault/

# Atomic-write temp files, if a write is ever interrupted.
*.tmp-*

# Jira push artefacts — they contain real issue content.
plan.json
issues.csv

# electron-vite build output
apps/desktop/out/

# In-progress plans — scratch space between an idea and the implementation.
# Ignored because a plan is not a description of the codebase, and the repo
# root should not accumulate documents that read as if it were. The durable
# record is PLAN.md, which each plan is folded into and then deleted from here.
#
# The contents are ignored rather than the directory, because git does not
# descend into an ignored directory and so never evaluates a negation inside
# one — `/plans/` followed by `!/plans/CLAUDE.md` would silently keep the file
# ignored. Ignoring `/plans/*` leaves the directory itself visible, which is
# what gives the negation something to override.
/plans/*
!/plans/CLAUDE.md
