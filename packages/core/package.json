{
  "name": "todo-vault",
  "version": "0.1.0",
  "description": "Local-first, Jira-shaped task vault with an MCP server so any Claude can read and write it",
  "type": "module",
  "bin": {
    "vault": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./description": {
      "types": "./dist/description.d.ts",
      "default": "./dist/description.js"
    },
    "./link-target": {
      "types": "./dist/link-target.d.ts",
      "default": "./dist/link-target.js"
    },
    "./recurrence": {
      "types": "./dist/recurrence.d.ts",
      "default": "./dist/recurrence.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-server.ts",
    "seed": "tsx scripts/seed-vault.ts",
    "test": "tsx --test test/vault.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
